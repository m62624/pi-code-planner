{
	"name": "pi-code-planner",
	"version": "0.12.0",
	"description": "Structured planning, TDD, and Git worktrees for Pi local coding agents",
	"keywords": [
		"pi-package",
		"pi-code",
		"pi-extension",
		"planner",
		"local-ai"
	],
	"homepage": "https://github.com/m62624/pi-code-planner#readme",
	"bugs": {
		"url": "https://github.com/m62624/pi-code-planner/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/m62624/pi-code-planner.git"
	},
	"type": "module",
	"main": "src/index.ts",
	"files": [
		"assets/*.webp",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"!src/test/**",
		"instructions/defaults/*.md",
		"vrf/defaults/*.vrf",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"image": "https://raw.githubusercontent.com/m62624/pi-code-planner/main/assets/icon.webp"
	},
	"license": "MIT",
	"scripts": {
		"build": "tsc",
		"check": "biome check .",
		"ci": "npm run check && npm run build && npm test && npm pack --dry-run",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@earendil-works/pi-coding-agent": "0.80.3",
		"@earendil-works/pi-tui": "0.80.3",
		"@types/node": "^26.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"elenchus-wasm": "^0.15.0",
		"tree-kill": "^1.2.2"
	}
}
